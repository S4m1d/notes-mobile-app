// The note editor. Every line is shown as rendered markdown, except the
// active line (the one holding the caret), which is a plain text input.

import { Theme, IconButton, Header } from "widgets.slint";

export enum LineKind { blank, paragraph, heading, bullet, ordered, task-open, task-done, quote, fence, code, rule }

export struct Line {
    // The markdown source of the line.
    raw: string,
    kind: LineKind,
    // Heading level (1-6).
    level: int,
    // List nesting level.
    indent: int,
    // Bullet or number shown in front of list items.
    marker: string,
    // The line without its block marker: plain for headings and code…
    plain: string,
    // …and with inline markdown rendered for everything else.
    text: styled-text,
}

component NoteLine inherits Rectangle {
    in property <Line> line;
    in property <bool> active;
    in property <int> cursor-offset;
    in property <int> anchor-offset;
    // The line holds the whole note, see `Editor.block`.
    in property <bool> block;
    // Extra space above the text in block mode.
    in property <length> pad;
    callback activate();
    callback selection-changed(anchor: int, cursor: int);
    callback edited(text: string);
    callback toggle-task();
    callback merge-up();
    callback cursor-moved(y: length);
    // This line just became the one being edited, or entered block mode.
    callback settle(y: length);

    property <bool> heading: line.kind == LineKind.heading;
    property <bool> code: line.kind == LineKind.code || line.kind == LineKind.fence;
    property <bool> task: line.kind == LineKind.task-open || line.kind == LineKind.task-done;
    property <bool> done: line.kind == LineKind.task-done;
    property <bool> list: line.kind == LineKind.bullet || line.kind == LineKind.ordered;
    property <bool> rule: line.kind == LineKind.rule;
    property <bool> blank: line.kind == LineKind.blank;
    property <length> heading-size: line.level == 1 ? 26px : line.level == 2 ? 22px : line.level == 3 ? 19px : 17px;

    background: root.active ? Theme.surface : (root.code ? #14161d : transparent);

    layout := HorizontalLayout {
        padding-left: 18px + (root.active || root.code ? 0px : root.line.indent * 18px);
        padding-right: 18px;
        padding-top: (!root.active && root.heading ? 12px : 4px) + root.pad;
        padding-bottom: 4px;
        spacing: 10px;
        min-height: !root.active && root.blank ? 16px : 30px;

        if !root.active && root.line.kind == LineKind.quote: Rectangle {
            width: 3px;
            border-radius: 1.5px;
            background: Theme.scarlet;
        }

        if !root.active && root.list: Text {
            text: root.line.marker;
            color: Theme.scarlet;
            font-size: 16px;
            font-weight: 700;
        }

        if !root.active && root.task: VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 5px;
                border-width: 1.5px;
                border-color: root.done ? Theme.green : Theme.scarlet;
                background: root.done ? Theme.green : transparent;
                if root.done: Image {
                    source: @image-url("icons/check.svg");
                    colorize: Theme.bg;
                    width: 16px;
                    height: 16px;
                }
            }
        }

        if !root.active && root.heading: Text {
            text: root.line.plain;
            color: Theme.scarlet;
            font-size: root.heading-size;
            font-weight: 700;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }

        if !root.active && root.code: Text {
            text: root.line.plain;
            color: root.line.kind == LineKind.fence ? Theme.muted : Theme.mint;
            font-family: "Droid Sans Mono";
            font-size: 14px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }

        if !root.active && root.rule: VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Rectangle {
                height: 1px;
                background: Theme.muted;
            }
        }

        if !root.active && !root.heading && !root.code && !root.rule && !root.blank: StyledText {
            text: root.line.text;
            default-color: root.done ? Theme.muted : Theme.text;
            default-font-size: 16px;
            link-color: Theme.cyan;
            horizontal-stretch: 1;
        }

        // Without a child the layout's max-width would be its padding; the
        // Flickable takes over the column's max-width, so one blank line
        // squeezed the whole note into a column as wide as its longest word.
        if !root.active && root.blank: Rectangle {
            horizontal-stretch: 1;
        }

        if root.active: TextInput {
            text: root.line.raw;
            color: white;
            font-size: 16px;
            single-line: false;
            wrap: word-wrap;
            horizontal-stretch: 1;
            selection-background-color: Theme.scarlet;
            selection-foreground-color: Theme.bg;
            // When a selection starts the app moves the whole note into this
            // line, so that the selection can grow past it.
            property <bool> block: root.block;
            property <length> caret-y;
            // Set while `settle` is about to report the caret instead.
            property <bool> settling;
            init => {
                self.focus();
                self.settling = true;
                self.set-selection-offsets(root.cursor-offset, root.cursor-offset);
                self.settling = false;
                root.settle(self.caret-y);
            }
            changed block => {
                if (self.block) {
                    self.settling = true;
                    self.text = root.line.raw;
                    self.set-selection-offsets(root.anchor-offset, root.cursor-offset);
                    self.settling = false;
                    root.settle(self.caret-y);
                }
            }
            changed cursor-position-byte-offset => {
                root.selection-changed(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
            }
            changed anchor-position-byte-offset => {
                root.selection-changed(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
            }
            edited => {
                root.edited(self.text);
            }
            key-pressed(event) => {
                if (event.text == Key.Backspace && self.cursor-position-byte-offset == 0 && self.anchor-position-byte-offset == 0) {
                    root.merge-up();
                    return accept;
                }
                reject
            }
            cursor-position-changed(position) => {
                self.caret-y = position.y;
                if (!self.settling) {
                    root.cursor-moved(position.y);
                }
            }
        }
    }

    // The caret marker of the active line.
    if root.active: Rectangle {
        x: 0px;
        width: 3px;
        background: Theme.mint;
    }

    if !root.active: TouchArea {
        clicked => {
            root.activate();
        }
    }

    // A generous tap target over the checkbox.
    if !root.active && root.task: TouchArea {
        x: 0px;
        width: layout.padding-left + 34px;
        clicked => {
            root.toggle-task();
        }
    }
}

export component Editor inherits Rectangle {
    in property <string> title;
    in property <[Line]> lines;
    in property <int> active-line: -1;
    in property <int> cursor-offset;
    in property <int> anchor-offset;
    // Block mode: while text is selected the note is a single line holding
    // all of its text, so that the selection can span lines.
    in property <bool> block;
    callback selection-changed(index: int, anchor: int, cursor: int);
    callback back();
    callback activate(index: int);
    callback edited(index: int, text: string);
    callback toggle-task(index: int);
    callback merge-up(index: int);
    callback tap-end();
    callback add-task();
    callback done();

    // The caret, in the coordinates of the scrolled content.
    property <length> caret-y;
    property <length> block-pad;
    // The value of `block` the two properties above are up to date with.
    property <bool> settled-block;

    // Entering and leaving block mode changes the height of the lines above
    // the caret. This keeps the caret where it was on the screen: the finger
    // that started the selection is still on it.
    function settle(row-y: length, y: length) {
        if (root.block != root.settled-block) {
            root.settled-block = root.block;
            if (root.block && root.caret-y > row-y + y) {
                root.block-pad = root.caret-y - row-y - y;
            } else {
                root.block-pad = 0px;
                flick.content-y = min(0px, flick.content-y + root.caret-y - row-y - y);
            }
        }
        root.caret-moved(row-y, y);
    }

    function caret-moved(row-y: length, y: length) {
        root.caret-y = row-y + (root.block ? root.block-pad : 0px) + y;
        root.reveal(root.caret-y);
    }

    // Scrolls just enough to keep the caret in view.
    function reveal(y: length) {
        if (y - 12px < -flick.content-y) {
            flick.content-y = min(0px, 12px - y);
        } else if (flick.height > 0 && y + 64px > flick.height - flick.content-y) {
            flick.content-y = flick.height - y - 64px;
        }
    }

    VerticalLayout {
        Header {
            title: root.title;
            back => {
                root.back();
            }
        }

        flick := Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: max(self.height, column.preferred-height + 260px);

            // Tapping below the last line continues the note.
            TouchArea {
                clicked => {
                    root.tap-end();
                }
            }

            column := VerticalLayout {
                x: 0px;
                y: 8px;
                width: flick.width;
                height: self.preferred-height;

                for line[index] in root.lines: NoteLine {
                    line: line;
                    active: index == root.active-line;
                    cursor-offset: root.cursor-offset;
                    anchor-offset: root.anchor-offset;
                    block: root.block && index == root.active-line;
                    pad: root.block && index == root.active-line ? root.block-pad : 0px;
                    selection-changed(anchor, cursor) => {
                        root.selection-changed(index, anchor, cursor);
                    }
                    activate => {
                        root.activate(index);
                    }
                    edited(text) => {
                        root.edited(index, text);
                    }
                    toggle-task => {
                        root.toggle-task(index);
                    }
                    merge-up => {
                        root.merge-up(index);
                    }
                    settle(y) => {
                        root.settle(self.y, y);
                    }
                    cursor-moved(y) => {
                        root.caret-moved(self.y, y);
                    }
                }
            }
        }

        // Editing toolbar; sits right above the on-screen keyboard.
        Rectangle {
            height: 50px;
            background: Theme.surface;

            Rectangle {
                y: 0px;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/task-add.svg");
                        clicked => {
                            root.add-task();
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                if root.active-line >= 0: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/check.svg");
                        tint: Theme.mint;
                        clicked => {
                            root.done();
                        }
                    }
                }
            }
        }
    }
}
